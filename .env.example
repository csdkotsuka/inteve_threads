# ==========================================
# Threads API 設定
# ==========================================
# Meta Developer で取得したアクセストークン（長文の英数字）
THREADS_ACCESS_TOKEN=your_threads_access_token_here

# Threads のユーザーID（任意: わからない場合は未記入でOK、APIから自動取得を試みます）
THREADS_USER_ID=

# ==========================================
# Firebase 設定（Webアプリ設定情報）
# ==========================================
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
